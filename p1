def task_11():
clear_screen()
print_header("ЗАДАНИЕ №11: РАСЧЕТ ПОКУПКИ И НДС")

try:
    price = float(input("  ► Введите цену товара: "))
    quantity = int(input("  ► Введите количество товара: "))

    if price < 0 or quantity < 0:
        print("\n  [!] Ошибка: цена и количество не могут быть отрицательными!")
        return

    cost = price * quantity
    nds = cost * 0.12
    total = cost + nds

    print("\n" + "-" * 55)
    print("  Результаты вычислений:")
    print(f"    • Стоимость покупки : {cost:,.2f}")
    print(f"    • НДС (12%)         : {nds:,.2f}")
    print(f"    • Итоговая стоимость: {total:,.2f}")
    print("-" * 55)

except ValueError:
    print("\n  [!] Ошибка: пожалуйста, вводите корректные числа.")

