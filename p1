def task_6():
clear_screen()
print_header("ЗАДАНИЕ №6: ПЛОЩАДЬ ТРЕУГОЛЬНИКА")

try:
    base = float(input("  ► Введите основание треугольника: "))
    height = float(input("  ► Введите высоту треугольника: "))

    if base <= 0 or height <= 0:
        print("\n  [!] Ошибка: основание и высота должны быть больше нуля!")
        return

    S = (base * height) / 2

    print("\n" + "-" * 55)
    print("  Результаты вычислений:")
    print(f"    • Основание : {base:,.2f}")
    print(f"    • Высота    : {height:,.2f}")
    print(f"    • Площадь   : {S:,.2f}")
    print("-" * 55)

except ValueError:
    print("\n  [!] Ошибка: пожалуйста, вводите только числа.")

