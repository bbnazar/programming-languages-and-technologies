def task_18():
clear_screen()
print_header("ЗАДАНИЕ №18: ЧИСЛО В ОБРАТНОМ ПОРЯДКЕ")

try:
    num = int(input("  ► Введите трехзначное целое число: "))

    if not (100 <= num <= 999):
        print("\n  [!] Ошибка: число должно быть трехзначным!")
        return

    hundreds = num // 100
    tens = (num % 100) // 10
    units = num % 10

    reverse = units * 100 + tens * 10 + hundreds

    print("\n" + "-" * 55)
    print("  Результат:")
    print(f"    • Исходное число : {num}")
    print(f"    • Обратное число : {reverse}")
    print("-" * 55)

except ValueError:
    print("\n  [!] Ошибка: введите целое трехзначное число.")

